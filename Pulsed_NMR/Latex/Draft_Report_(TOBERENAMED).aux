\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces This is a voltage vs time graph clearly displaying a FID curve with a sharp peak. We find that because of our low signal, the 10 mV noise is apparent in the plot. This is reflected in the statistical error obtained by the fitting curve. The standard error for the amplitude parameter was 8\% and the error for $T_2^*$ was 0.6\%. We find that the slope is quite accurately fitted whereas the amplitude has more variation, which aligns with the visual from the graph.}}{9}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:goodtime}{{1}{9}{This is a voltage vs time graph clearly displaying a FID curve with a sharp peak. We find that because of our low signal, the 10 mV noise is apparent in the plot. This is reflected in the statistical error obtained by the fitting curve. The standard error for the amplitude parameter was 8\% and the error for $T_2^*$ was 0.6\%. We find that the slope is quite accurately fitted whereas the amplitude has more variation, which aligns with the visual from the graph}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The peak FID amplitude displays a sinusoidal relationship with the duration of the pulse. We find that the signal is particularly weak as near the points of interest, i.e the peak and troughs of the graph and the point at which the amplitude is zero, we find more varying behaviour. We find that the standard error in the frequency of the graph is 6\% using the curve fit parameters. The extrema of the graph occur when the pulse length is 2.52 $\mu $s and 7.59 $\mu $s.}}{10}{figure.caption.3}\protected@file@percent }
\newlabel{fig:badpulselength}{{2}{10}{The peak FID amplitude displays a sinusoidal relationship with the duration of the pulse. We find that the signal is particularly weak as near the points of interest, i.e the peak and troughs of the graph and the point at which the amplitude is zero, we find more varying behaviour. We find that the standard error in the frequency of the graph is 6\% using the curve fit parameters. The extrema of the graph occur when the pulse length is 2.52 $\mu $s and 7.59 $\mu $s}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Same plot as before but with 10x the signal. We find a smoother relationship visually. We find our standard error for the frequency of the graph goes down to 5\%. The behaviour around the extrema are less chaotic due to higher signal to noise. The corresponding pulse length values are 2.48, 5.02 and 7.47 $\mu $s for $90^\circ $, $180^\circ $ and $270^\circ $ respectively.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:goodpulselength}{{3}{11}{Same plot as before but with 10x the signal. We find a smoother relationship visually. We find our standard error for the frequency of the graph goes down to 5\%. The behaviour around the extrema are less chaotic due to higher signal to noise. The corresponding pulse length values are 2.48, 5.02 and 7.47 $\mu $s for $90^\circ $, $180^\circ $ and $270^\circ $ respectively}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparing with the previous FID curve, we find this to be 10x the signal again. However this time, there is a large dip right after the decay of the curve. This does not impact the FID curve directly however pulses after this initial curve would not be read correctly.}}{12}{figure.caption.5}\protected@file@percent }
\newlabel{fig:badtime}{{4}{12}{Comparing with the previous FID curve, we find this to be 10x the signal again. However this time, there is a large dip right after the decay of the curve. This does not impact the FID curve directly however pulses after this initial curve would not be read correctly}{figure.caption.5}{}}
